# Blob storage backend (fsspec URL). Local disk by default; gs://bucket/prefix in prod.
RESEARCH_BLOB_URL=file:///data

# Signs/verifies /blob/<token> links — required, must not be empty.
# Generate with: openssl rand -hex 32
BLOB_TOKEN_SECRET=changeme

# Base URL this service is reachable at, used to build upload/blob links
# returned by get_upload_link and get_file_url. Must be the address a human
# or the calling agent can actually reach.
PUBLIC_BASE_URL=http://localhost:8090

# Host port to publish the service on.
MCP_RESEARCH_PORT=8090

# Only needed when RESEARCH_BLOB_URL is gs://... — path to a service-account
# credential JSON, mounted into the container.
# GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=/path/to/gcs-sa.json
