# Public host and scheme as users see them. TLS ends at the Google load balancer, the stack itself
# only speaks http. (`./deploy.sh --dev` forces localhost + http.)
PUBLIC_HOST=browsers.example.org
PUBLIC_SCHEME=https

# OIDC issuer of your Keycloak (prod: the real IdP; `./deploy.sh --dev` overrides this with a local one).
# Initialize it with keycloak/setup.sh (see README): realm, scopes, DCR for Claude.
OIDC_ISSUER=https://keycloak.example.org/realms/newsroom

# Scope the access token must carry (advertised to Claude, which requests it). Empty = no scope check.
# The audience is not checked. setup.sh creates the scope as a realm default.
MCP_SCOPE=spider-hoarder

# oauth2-proxy (live-view login) registers its own Keycloak client via DCR; no id/secret needed.
# python3 -c 'import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
O2P_COOKIE_SECRET=change-me

# Signs/verifies blob and upload links — required, must not be empty.
# Generate with: openssl rand -hex 32
BLOB_TOKEN_SECRET=changeme

# Blob storage backend (fsspec URL). Local disk by default; gs://bucket/prefix in prod.
RESEARCH_BLOB_URL=file:///data

# Concurrent sessions per egress container (Tor SocksPorts and the uid pool follow from this;
# max 48). Per-user cap and idle timeout (seconds).
MAX_SESSIONS_TOTAL=18
MAX_SESSIONS_PER_USER=3
IDLE_TIMEOUT=1800

# Port nginx is published on (the LB / dev browser connects here; `./deploy.sh --dev` puts it in PUBLIC_HOST).
HTTP_PORT=7297

# Port the research gateways listen on; nginx connects to it on any replica IP, so nothing else may use it.
GATEWAY_PORT=7298

# Replicas per egress (also `docker service scale spider-hoarder_research-clear=N`). MAX_REPLICAS caps
# the slot numbers and sizes tor's SocksPort ranges: raise it (and redeploy tor) before scaling past it.
RESEARCH_TOR_REPLICAS=1
RESEARCH_CLEAR_REPLICAS=1
MAX_REPLICAS=4

# --- Only used by `./deploy.sh --dev` (local Keycloak) and keycloak/setup.sh; ignored in prod ---
KC_REALM=newsroom
# The initial user that can use spider-hoarder; setup.sh (re)sets this password on every run.
KC_USER=researcher
KC_USER_PASSWORD=researcher-pw
