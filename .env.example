# Public host and scheme as users see them. TLS ends at the Google load balancer, the stack itself
# only speaks http. (`./deploy.sh --dev` forces localhost + http.)
PUBLIC_HOST=browsers.example.org
PUBLIC_SCHEME=https

# OIDC issuer of your Keycloak (prod: the real IdP; `./deploy.sh --dev` overrides this with a local one).
# Initialize it with keycloak/setup.sh (see README): realm, scopes, DCR for Claude.
OIDC_ISSUER=https://keycloak.example.org/realms/newsroom

# Scope the access token must carry (advertised to Claude, which requests it). Empty = no scope check.
# The audience is not checked. setup.sh creates the scope as a realm default.
MCP_SCOPE=spider-hoarder

# oauth2-proxy (live-view login) registers its own Keycloak client via DCR; no id/secret needed.
# python3 -c 'import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
O2P_COOKIE_SECRET=change-me

# Signs/verifies blob and upload links — required, must not be empty.
# Generate with: openssl rand -hex 32
BLOB_TOKEN_SECRET=changeme

# Blob storage backend (fsspec URL). Local disk by default; gs://bucket/prefix in prod.
RESEARCH_BLOB_URL=file:///data

# Concurrent sessions per egress container (Tor SocksPorts and the uid pool follow from this;
# max 48). Per-user cap and idle timeout (seconds).
MAX_SESSIONS_TOTAL=18
MAX_SESSIONS_PER_USER=3
IDLE_TIMEOUT=1800
# An MCP client with no open connection for this long loses its session (browser and reservation freed)
DISCONNECT_TIMEOUT_MINUTES=5

# Port nginx is published on (the LB / dev browser connects here; `./deploy.sh --dev` puts it in PUBLIC_HOST).
HTTP_PORT=7297

# Port the research gateways listen on; nginx connects to it on any replica IP, so nothing else may use it.
GATEWAY_PORT=7298

# Replicas per egress (also `docker service scale spider-hoarder_research-clear=N`). MAX_REPLICAS caps
# the slot numbers and sizes tor's SocksPort ranges: raise it (and redeploy tor) before scaling past it.
RESEARCH_TOR_REPLICAS=1
RESEARCH_CLEAR_REPLICAS=1
MAX_REPLICAS=4

# --- Android emulators (opt in; off while both replica counts are 0) ---
# Needs a KVM-capable x86_64 host (nested virtualisation on a cloud VM): deploy.sh builds the slot image and makes the
# golden snapshot on the host it runs on. Each slot is a 2-CPU / 8 GB emulator, one session at a time, wiped between
# sessions; capacity = replicas x slots per replica, per egress. A busy server answers "busy" at once.
ANDROID_CLEAR_REPLICAS=0
ANDROID_TOR_REPLICAS=0
ANDROID_SLOTS_PER_REPLICA=2
# Seconds without a tool call before a session ends and its slot is wiped (waiting for the user does not count)
ANDROID_IDLE_TIMEOUT=600
# Android API level of the Google Play system image
ANDROID_API=34
# Shared secret between the gateways and the slots (control verbs and tool server). openssl rand -hex 32
SLOT_SECRET=changeme
# F-Droid is preinstalled; the build verifies this APK. Pin a VERSIONED url (the unversioned one changes with every
# release, and so does its checksum).
ANDROID_FDROID_URL=https://f-droid.org/repo/org.fdroid.fdroid_2000052.apk
ANDROID_FDROID_SHA256=19d51fad482239f6df6a99120e34513667e9a86d136dafdc4a211a68c3327b52
# Optional: sha256 of the Android command-line tools archive (Dockerfile ARG CMDLINE_TOOLS_URL)
#ANDROID_CMDLINE_TOOLS_SHA256=
# Optional: swarm placement of the wrapper (it must run on the KVM node), emulator size, kvm group gid override
#ANDROID_PLACEMENT=node.role == manager
#ANDROID_SLOT_CPUS=2
#ANDROID_SLOT_MEMORY=8g
#ANDROID_KVM_GID=
# A slot (re)start reads the ~3 GB RAM snapshot: seconds on an SSD, minutes on a throttled cloud disk. Boot limit inside
# the slot, and the gateway's wait for a reset (keep it above the boot limit)
#ANDROID_BOOT_TIMEOUT=240
# Guest RAM in MB, baked into the golden snapshot (changing it re-makes the snapshot): the slot's memory limit must be
# about 2 GB above it. Smaller = less disk read per restore and less RAM per slot, at the cost of a sluggish guest.
#ANDROID_RAM_MB=3072
#ANDROID_RESET_TIMEOUT=300
# Subnet of the Tor-only slot network: outside 10.192.0.0/10 (tor's virtual onion range) and unused by other overlays
#ANDROID_TOR_SUBNET=10.99.0.0/24

# --- Only used by `./deploy.sh --dev` (local Keycloak) and keycloak/setup.sh; ignored in prod ---
KC_REALM=newsroom
# The initial user that can use spider-hoarder; setup.sh (re)sets this password on every run.
KC_USER=researcher
KC_USER_PASSWORD=researcher-pw
